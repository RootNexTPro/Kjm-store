<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KJM Store Online</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .modal { display: none; }
        .modal.active { display: flex; }
    </style>
</head>
<body class="bg-gray-50 text-gray-900">

    <!-- Header -->
    <header class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <span class="text-2xl font-bold text-indigo-600">KJM Store Online</span>
                <a href="purchases.html" class="text-sm font-medium text-gray-600 hover:text-indigo-600 transition-colors ml-6">Mes Achats 📦</a>
            </div>
            <div class="flex items-center space-x-4">
                <div class="flex items-center text-sm font-medium text-green-600 bg-green-50 px-3 py-1 rounded-full border border-green-200">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                    Paiement Sécurisé
                </div>
                <select class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2">
                    <option value="XAF">XAF</option>
                </select>
            </div>
        </div>
    </header>

    <!-- Hero Banner -->
    <section class="bg-indigo-600 text-white py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h1 class="text-4xl md:text-5xl font-bold mb-4">Bienvenue sur KJM Store Online</h1>
            <p class="text-xl text-indigo-100 mb-8 max-w-2xl mx-auto">Votre boutique de produits digitaux premium. Accédez instantanément à nos abonnements, formations, et logiciels.</p>
            <div class="inline-flex items-center space-x-2 bg-indigo-500 bg-opacity-50 px-4 py-2 rounded-full text-sm font-medium">
                <svg class="w-5 h-5 text-yellow-300" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                <span>Livraison 24h/24 & 7j/7 automatique</span>
            </div>
        </div>
    </section>

    <!-- Category Filters -->
    <section class="py-8 bg-white border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-wrap justify-center gap-3">
                <button class="filter-btn active bg-indigo-600 text-white px-5 py-2 rounded-full text-sm font-medium transition-colors" data-category="Tous">Tous</button>
                <button class="filter-btn bg-gray-100 text-gray-700 hover:bg-gray-200 px-5 py-2 rounded-full text-sm font-medium transition-colors" data-category="Abonnements IA">Abonnements IA</button>
                <button class="filter-btn bg-gray-100 text-gray-700 hover:bg-gray-200 px-5 py-2 rounded-full text-sm font-medium transition-colors" data-category="Formations & E-books">Formations & E-books</button>
                <button class="filter-btn bg-gray-100 text-gray-700 hover:bg-gray-200 px-5 py-2 rounded-full text-sm font-medium transition-colors" data-category="Logiciels & Licences">Logiciels & Licences</button>
                <button class="filter-btn bg-gray-100 text-gray-700 hover:bg-gray-200 px-5 py-2 rounded-full text-sm font-medium transition-colors" data-category="Packs & Bundles">Packs & Bundles</button>
            </div>
        </div>
    </section>

    <!-- Product Grid -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            <!-- Products will be injected here -->
            <div class="col-span-full text-center py-10 text-gray-500" id="loading-indicator">
                Chargement des produits...
            </div>
        </div>
    </main>

    <!-- Express Checkout Modal -->
    <div id="checkout-modal" class="modal fixed inset-0 z-[100] bg-black bg-opacity-50 items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden relative">
            <div class="p-6">
                <button type="button" id="close-modal" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
                <h3 class="text-2xl font-bold text-gray-900 mb-2">Paiement Express</h3>
                <p class="text-sm text-gray-500 mb-6" id="modal-product-title">Produit sélectionné</p>

                <form id="checkout-form" class="space-y-4">
                    <input type="hidden" id="product_id">
                    <input type="hidden" id="product_price">
                    <input type="hidden" id="product_name_hidden">

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Nom complet</label>
                        <input type="text" id="customer_name" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Email (pour la livraison)</label>
                        <input type="email" id="customer_email" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500">
                    </div>
                    <div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Code Promo (Optionnel)</label>
                        <div class="flex space-x-2">
                            <input type="text" id="promo_code" class="flex-grow px-4 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 uppercase">
                            <button type="button" id="apply-promo-btn" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium py-2 px-4 rounded-lg transition-colors">Appliquer</button>
                        </div>
                        <p id="promo-message" class="text-xs mt-1 hidden"></p>
                    </div>

                        <label class="block text-sm font-medium text-gray-700 mb-1">Téléphone (Mobile Money)</label>
                        <input type="tel" id="customer_phone" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500">
                    </div>

                    <button type="submit" id="submit-btn" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-4 rounded-lg transition-colors mt-6">
                        Confirmer la commande - <span id="modal-price">0</span> XAF
                    </button>
                </form>

                <div id="success-message" class="hidden flex-col items-center justify-center py-6 text-center">
                    <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
                        <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    </div>
                    <p class="text-lg font-semibold text-gray-900">Commande enregistrée !</p>
                    <p class="text-sm text-gray-500 mt-2">Redirection vers le paiement sécurisé...</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        const POCKETBASE_URL = window.location.origin; // Assuming PocketBase serves this directly
        const NOTCHPAY_PUBLIC_KEY = 'pk_test_placeholder_key'; // Replace with actual public key if needed or inject via template

        let currentCategory = 'Tous';
        let allProducts = [];

        // DOM Elements
        const grid = document.getElementById('product-grid');
        const loader = document.getElementById('loading-indicator');
        const filterBtns = document.querySelectorAll('.filter-btn');
        const modal = document.getElementById('checkout-modal');
        const closeModal = document.getElementById('close-modal');
        const checkoutForm = document.getElementById('checkout-form');
        const successMessage = document.getElementById('success-message');

        // Fetch products
        async function fetchProducts() {
            try {
                // In a real scenario, use actual PocketBase API:
                const res = await fetch(`${POCKETBASE_URL}/api/collections/products/records?filter=is_active=true`);
                if (res.ok) {
                    const data = await res.json();
                    allProducts = data.items;
                } else {
                    console.error('Failed to fetch from real API, falling back to empty list.');
                }
                renderProducts();
            } catch (error) {
                console.error('Error fetching products:', error);
                loader.innerHTML = 'Erreur lors du chargement des produits.';
            }
        }

        function renderProducts() {
            grid.innerHTML = '';
            const filtered = currentCategory === 'Tous'
                ? allProducts
                : allProducts.filter(p => p.category === currentCategory);

            if (filtered.length === 0) {
                grid.innerHTML = '<div class="col-span-full text-center py-10 text-gray-500">Aucun produit trouvé dans cette catégorie.</div>';
                return;
            }

            filtered.forEach(product => {
                const coverUrl = product.cover
                    ? `${POCKETBASE_URL}/api/files/${product.collectionId}/${product.id}/${product.cover}`
                    : 'https://via.placeholder.com/640x360?text=KJM+Store';

                const originalPriceHtml = product.original_price > product.price
                    ? `<span class="text-sm text-gray-400 line-through mr-2">${product.original_price} XAF</span>`
                    : '';

                const promoBadge = product.original_price > product.price
                    ? `<div class="absolute top-2 left-2 bg-red-500 text-white text-xs font-bold px-2 py-1 rounded">PROMO</div>`
                    : '';

                const card = document.createElement('div');
                card.className = 'bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow group flex flex-col';
                card.innerHTML = `
                    <div class="relative aspect-video w-full bg-gray-100 overflow-hidden">
                        <img src="${coverUrl}" alt="${product.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                        ${promoBadge}
                    </div>
                    <div class="p-5 flex-1 flex flex-col">
                        <div class="flex items-center mb-2">
                            <span class="text-yellow-400 text-sm">⭐⭐⭐⭐⭐</span>
                            <span class="text-gray-500 text-xs ml-1 font-medium">5.0</span>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 mb-1 flex-1 leading-tight">${product.title}</h3>
                        <div class="mt-4 flex items-center justify-between">
                            <div>
                                ${originalPriceHtml}
                                <span class="text-xl font-extrabold text-indigo-600">${product.price} XAF</span>
                            </div>
                        </div>
                        <button onclick="openCheckout('${product.id}', '${product.title.replace(/'/g, "\\'")}', ${product.price})" class="w-full mt-4 bg-gray-900 hover:bg-indigo-600 text-white font-medium py-2 px-4 rounded-lg transition-colors">
                            Acheter maintenant
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // Filtering
        filterBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                filterBtns.forEach(b => {
                    b.classList.remove('bg-indigo-600', 'text-white');
                    b.classList.add('bg-gray-100', 'text-gray-700');
                });
                e.target.classList.remove('bg-gray-100', 'text-gray-700');
                e.target.classList.add('bg-indigo-600', 'text-white');
                currentCategory = e.target.dataset.category;
                renderProducts();
            });
        });

        // Modal interactions
        window.openCheckout = function(id, title, price) {
            document.getElementById('product_id').value = id;
            document.getElementById('product_price').value = price;
            document.getElementById('product_name_hidden').value = title;

            document.getElementById('modal-product-title').textContent = title;
            document.getElementById('modal-price').textContent = price;

            discountedPrice = null;
            document.getElementById('promo_code').value = '';
            document.getElementById('promo-message').classList.add('hidden');


            checkoutForm.classList.remove('hidden');
            successMessage.classList.add('hidden');
            modal.classList.add('active');
        };

        closeModal.addEventListener('click', () => {
            modal.classList.remove('active');
        });

        modal.addEventListener('click', (e) => {
            if(e.target === modal) modal.classList.remove('active');
        });


        let discountedPrice = null;

        document.getElementById('apply-promo-btn').addEventListener('click', async () => {
            const codeInput = document.getElementById('promo_code');
            const code = codeInput.value.trim().toUpperCase();
            const msgEl = document.getElementById('promo-message');
            const originalPrice = parseFloat(document.getElementById('product_price').value);

            if (!code) return;

            try {
                const res = await fetch(`${POCKETBASE_URL}/api/collections/coupons/records?filter=(code='${code}' && is_active=true)`);
                const data = await res.json();

                msgEl.classList.remove('hidden');

                if (data.items && data.items.length > 0) {
                    const coupon = data.items[0];
                    // Verify max_uses if you want, but this is a simplified check

                    let discount = 0;
                    if (coupon.discount_percent) {
                        discount = originalPrice * (coupon.discount_percent / 100);
                    } else if (coupon.discount_amount) {
                        discount = coupon.discount_amount;
                    }

                    discountedPrice = Math.max(0, originalPrice - discount);

                    msgEl.textContent = `Code appliqué : -${coupon.discount_percent ? coupon.discount_percent + '%' : discount + ' XAF'}`;
                    msgEl.className = 'text-xs mt-1 text-green-600 font-medium';

                    document.getElementById('modal-price').innerHTML = `
                        <span class="line-through text-indigo-300 text-sm mr-1">${originalPrice}</span>
                        ${discountedPrice}
                    `;
                } else {
                    discountedPrice = null;
                    msgEl.textContent = 'Code promo invalide ou expiré';
                    msgEl.className = 'text-xs mt-1 text-red-600 font-medium';
                    document.getElementById('modal-price').textContent = originalPrice;
                }
            } catch (err) {
                console.error(err);
                discountedPrice = null;
                msgEl.textContent = 'Erreur de vérification';
                msgEl.className = 'text-xs mt-1 text-red-600 font-medium';
                document.getElementById('modal-price').textContent = originalPrice;
            }
        });

        // Checkout logic
        checkoutForm.addEventListener('submit', async (e) => {
            e.preventDefault();

            const submitBtn = document.getElementById('submit-btn');
            submitBtn.disabled = true;
            submitBtn.textContent = 'Traitement...';

            const name = document.getElementById('customer_name').value;
            const email = document.getElementById('customer_email').value;
            const phone = document.getElementById('customer_phone').value;
            const productTitle = document.getElementById('product_name_hidden').value;
            const originalAmount = parseFloat(document.getElementById('product_price').value);
            const amount = discountedPrice !== null ? discountedPrice : originalAmount;

            // Generate CMD-XXXXXX reference
            const reference = 'CMD-' + Math.floor(100000 + Math.random() * 900000);

            try {
                // 1. Save order to PocketBase
                const orderData = {
                    customer_name: name,
                    customer_email: email,
                    customer_phone: phone,
                    product_title: productTitle,
                    amount: amount,
                    status: 'pending',
                    reference: reference
                };

                await fetch(`${POCKETBASE_URL}/api/collections/orders/records`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(orderData)
                });

                // 2. Show success message briefly
                checkoutForm.classList.add('hidden');
                successMessage.classList.remove('hidden');
                successMessage.classList.add('flex');

                // 3. Init Notch Pay
                const notchPayData = {
                    email: email,
                    amount: amount,
                    currency: 'XAF',
                    reference: reference,
                    callback: `${window.location.origin}/success.html?reference=${reference}`,
                    description: \`Achat: \${productTitle}\`,
                    customer: {
                        name: name,
                        email: email,
                        phone: phone
                    }
                };

                const paymentRes = await fetch('https://api.notchpay.co/payments', {
                    method: 'POST',
                    headers: {
                        'Authorization': \`\${NOTCHPAY_PUBLIC_KEY}\`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(notchPayData)
                });

                if(paymentRes.ok) {
                    const paymentData = await paymentRes.json();
                    if(paymentData.authorization_url) {
                        setTimeout(() => {
                            window.location.href = paymentData.authorization_url;
                        }, 1500);
                    }
                } else {
                    console.error('Notch Pay error', await paymentRes.text());
                    alert("Erreur lors de l'initialisation du paiement.");
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Confirmer la commande';
                    checkoutForm.classList.remove('hidden');
                    successMessage.classList.add('hidden');
                    successMessage.classList.remove('flex');
                }

            } catch (error) {
                console.error(error);
                alert("Une erreur est survenue.");
                submitBtn.disabled = false;
                submitBtn.textContent = 'Confirmer la commande';
            }
        });

        // Init
        fetchProducts();
    </script>
</body>
</html>
